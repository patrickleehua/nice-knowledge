# nicekit demo 后端环境变量示例。复制为 .env 后按需修改。
# 变量名与 nicekit.core.config 的 Settings 字段一一对应(分域定义,组合成一个 Settings)。

# ---- 基础 ----
APP_NAME=nicekit demo
DEPLOYMENT_ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 数据库(docker compose 的 postgres 在宿主 5433)----
# 应用账号与迁移账号分离,两个都没有 BYPASSRLS:FORCE RLS 下 owner 也受策略约束
DATABASE_URL=postgresql+psycopg://niceknowledge_app:app-dev-secret@localhost:5433/niceknowledge
MIGRATION_DATABASE_URL=postgresql+psycopg://niceknowledge_migrator:migrator-dev-secret@localhost:5433/niceknowledge

# ---- Redis / MinIO(compose 端口错开:6380 / 9010)----
REDIS_URL=redis://localhost:6380/0
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=niceknowledge
MINIO_SECRET_KEY=niceknowledge-dev-secret
MINIO_BUCKET=niceknowledge
MINIO_SECURE=false

# ---- 密钥 ----
# JWT 签名密钥:必须 >= 32 字节(HS256 的最低推荐长度;生产环境 readiness 会强校验)
JWT_SECRET=demo-jwt-secret-please-replace-with-32-plus-bytes
# 落库敏感字段的加密 master key(provider api_key / service_config 密钥 / MCP headers+env)。
# 留空 = 明文直通模式(仅开发可接受);一旦配置就不能再丢,否则已有密文解不开。
NICEKIT_SECRET_KEY=demo-master-key-please-replace-with-a-long-random-string

# ---- 任务派发 ----
# inline = API 进程内 BackgroundTasks + lifespan 常驻循环(开发默认)
# celery = 生产主路径,需另起 worker 与 beat:
#   uv run celery -A nicekit.runtime.celery_app worker --pool=solo -l info
#   uv run celery -A nicekit.runtime.celery_app beat -l info
TASK_DISPATCH_MODE=inline

# ---- 日志 / 限流 ----
LOG_LEVEL=INFO
LOG_FORMAT=console
RATE_LIMIT_PER_MINUTE=240
RATE_LIMIT_BACKEND=memory

# ---- LLM(不配也能起服务,只是对话/抽取链路不可用)----
# 平台默认模型:配了才会 seed agent.default / kb.answer 两条系统路由
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ---- KB 嵌入(首次部署指纹;换模型走 embedding reindex campaign)----
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL=BAAI/bge-m3
KB_EMBEDDING_DIM=1024
